# Copy to `.env` (never commit real keys). Read at API start-up.

# --- AI (text only): one free OpenRouter model, Groq as the single backup (ADR-005) ---
# OpenRouter key from openrouter.ai/keys. Only a model id ending in ":free" is ever used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Backup when OpenRouter is busy or fails.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Without any key the app still reads photos: prescriptions show the medicine names matched from the text
# ("AI busy: details not extracted"), food labels use the parser only.

# --- Plant identification: PlantNet API key from my.plantnet.org (free tier: 500 identifications/day) ---
# Photos are sent to PlantNet (Pl@ntNet, France) for identification.
PLANTNET_API_KEY=

# --- OCR (RapidOCR, models in weights/ocr/ from scripts/setup_ocr_models.py) ---
# Model set: v6-small (default) | v6-medium | v5-mobile | v5-server. See project_review/ADR-005.
# OCR_MODELS=v6-small
# Devanagari (Hindi) second reading for prescriptions: 1 (default) | 0
# OCR_HINDI=1
